# Optional V2-only PostgreSQL URL. Must resolve to loopback; never put a V1/production URL here.
V2_DATABASE_URL=postgresql+psycopg://v2_local:v2_local@127.0.0.1:55432/mikrotik_manager_v2
V2_SESSION_SECURE=false

# Demo persistence uses only the URL above (v2_local / mikrotik_manager_v2 / 55432).
# Explicit first-time setup: ./dev.sh --prepare-demo (never auto-run at application startup)

# Future CEBECI-only API-SSL transport. An enable request does NOT grant execution;
# current backend DEVICE_READ remains forbidden and this adapter is not a live provider.
V2_CEBECI_API_SSL_ENABLED=false
V2_CEBECI_API_SSL_HOST=10.250.0.19
V2_CEBECI_API_SSL_SOURCE_IP=10.250.0.1
V2_CEBECI_API_SSL_PORT=8729
V2_CEBECI_API_SSL_CONNECT_TIMEOUT=2
V2_CEBECI_API_SSL_IO_TIMEOUT=2
V2_CEBECI_API_SSL_TOTAL_TIMEOUT=10
# Required future public trust material; no private key or client certificate.
V2_CEBECI_API_SSL_CA_PEM=
V2_CEBECI_API_SSL_LEAF_SHA256=
# Inject dedicated V2 credentials at runtime only. NEVER put actual values in this file.
V2_CEBECI_API_SSL_USERNAME=
V2_CEBECI_API_SSL_PASSWORD=
