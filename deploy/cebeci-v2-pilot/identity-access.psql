\set ON_ERROR_STOP on
\set ECHO none
\set VERBOSITY terse
\set QUIET on
BEGIN;
DO $$ BEGIN
 IF current_database()<>'mikrotik_manager_v2' OR current_user<>'v2_pilot_maint'
 OR current_setting('port')<>'55432'
 OR current_setting('data_directory')<>'/srv/mikrotik-manager-v2-pilot/postgres'
 THEN RAISE EXCEPTION 'V2_TARGET_REJECTED'; END IF;
 IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname='v2_local' AND
 (rolsuper OR rolcreatedb OR rolcreaterole OR rolreplication OR rolbypassrls))
 OR EXISTS (SELECT 1 FROM pg_auth_members m JOIN pg_roles r ON r.oid=m.member WHERE r.rolname='v2_local')
 OR EXISTS (SELECT 1 FROM pg_class WHERE relowner=(SELECT oid FROM pg_roles WHERE rolname='v2_local'))
 OR EXISTS (SELECT 1 FROM pg_namespace WHERE nspowner=(SELECT oid FROM pg_roles WHERE rolname='v2_local'))
 OR EXISTS (SELECT 1 FROM pg_database WHERE datdba=(SELECT oid FROM pg_roles WHERE rolname='v2_local'))
 THEN RAISE EXCEPTION 'V2_APP_ROLE_OWNERSHIP_REJECTED'; END IF;
END $$;
REVOKE CREATE ON SCHEMA public FROM PUBLIC, v2_local;
REVOKE ALL ON SCHEMA v2_demo, v2_router_workspace, v2_subscriber_workspace FROM PUBLIC, v2_local;
GRANT USAGE ON SCHEMA public, v2_demo, v2_router_workspace, v2_subscriber_workspace TO v2_local;
REVOKE ALL ON ALL TABLES IN SCHEMA v2_demo, v2_router_workspace, v2_subscriber_workspace FROM PUBLIC, v2_local;
REVOKE ALL ON public.v2_registered_routers,public.v2_router_verifications,public.v2_router_registry_audit FROM PUBLIC, v2_local;
-- Remove column grants too: table-level REVOKE does not revoke column privileges.
REVOKE ALL (id,username,name,email,role,active,password_hash,permissions,revision,account_origin) ON v2_demo.users FROM PUBLIC, v2_local;
REVOKE ALL (version,marker,identity_initialized,first_admin_initialized) ON v2_demo.schema_state FROM PUBLIC, v2_local;
REVOKE ALL (singleton,admin_id,local_operator_uid,completed_at) ON v2_demo.first_admin_setup FROM PUBLIC, v2_local;
GRANT SELECT ON v2_demo.users, v2_demo.schema_state, v2_demo.first_admin_setup, v2_demo.user_audit TO v2_local;
GRANT INSERT ON v2_demo.users, v2_demo.user_audit TO v2_local;
GRANT UPDATE (name,email,role,active,permissions,revision) ON v2_demo.users TO v2_local;
GRANT SELECT,INSERT,UPDATE ON v2_demo.subscribers,v2_demo.events,v2_demo.requests,
 v2_demo.alarm_actions,v2_demo.alarm_requests,v2_demo.settings_records,v2_demo.settings_audit,
 v2_router_workspace.records,v2_router_workspace.audit,
 v2_subscriber_workspace.subscribers,v2_subscriber_workspace.events,
 public.v2_registered_routers,public.v2_router_verifications,public.v2_router_registry_audit TO v2_local;
GRANT DELETE ON v2_router_workspace.records TO v2_local;
COMMIT;
