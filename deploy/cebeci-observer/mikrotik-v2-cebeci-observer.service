[Unit]
Description=MikroTik V2 CEBECI_TOWERS read-only observer
Wants=network-online.target
After=network-online.target mikrotik-v2-cebeci-netguard.service
Requires=mikrotik-v2-cebeci-netguard.service

[Service]
Type=simple
User=mtv2-cebeci-observer
Group=mtv2-cebeci-read
WorkingDirectory=/opt/mikrotik-v2-cebeci-observer
Environment=PYTHONPATH=/opt/mikrotik-v2-cebeci-observer/backend
ExecStartPre=+/usr/bin/python3 -I -B /opt/mikrotik-v2-cebeci-observer/network-guard.py verify
ExecStartPre=/opt/mikrotik-v2-cebeci-observer/venv/bin/python -B -m app.cebeci_observer preflight-managed
ExecStart=/opt/mikrotik-v2-cebeci-observer/venv/bin/python -B -m app.cebeci_observer run-managed
Restart=no
RuntimeDirectory=mikrotik-v2-cebeci-observer
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=no
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET
BPFProgram=sock_create:/sys/fs/bpf/mtv2-cebeci-guard/sock_create
BPFProgram=connect4:/sys/fs/bpf/mtv2-cebeci-guard/connect4
SystemCallArchitectures=native
SystemCallFilter=~listen accept accept4 sendto sendmsg sendmmsg io_uring_setup io_uring_enter io_uring_register pidfd_getfd socketcall
LimitCORE=0
TimeoutStopSec=35s

[Install]
WantedBy=multi-user.target
